# Rust
target/
# Cargo.lock is intentionally NOT ignored: this workspace ships the `minact`
# binary, so the lockfile is what makes CI and local builds reproducible.

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Minact
# What `actions/upload-artifact` produces; outputs, not source.
.minact/artifacts/
# Run history Studio records per project; local state, not source.
.minact/runs/
# The runner's own tree: job scratch space and the tool cache. It carries a
# `.gitignore` of its own too, for projects that never touch this file.
.minact/_work/
